{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "LOCAL",
            "request": "launch",
            "mainClass": "br.com.guimasnacopa.Application",
            "args": "--spring.profiles.active=local",
            "cwd": "${workspaceFolder}",
            "vmArgs": "-Dspring.thymeleaf.cache=false -Dspring.thymeleaf.prefix=file:src/main/resources/templates/ -Dspring.resources.static-locations=file:src/main/resources/static/,classpath:/static/"
       },
       {
            "type": "java",
            "name": "SYS PROD",
            "request": "launch",
            "mainClass": "br.com.guimasnacopa.Application",
            "args": "--spring.profiles.active=sysprod"
       },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Open in chrome",
            "url": "http://localhost:8080"
        }
    ]
} 